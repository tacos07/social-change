# ===========================================================================
# COPY this file to ".env" for local dev, or set these in your host (Render)
# environment-variable settings. NEVER commit real values. ".env" is gitignored.
# ===========================================================================

# --- THE SECRET DESTINATION -------------------------------------------------
# Your Signal group invite link. This is the one thing outsiders must not see.
# It lives ONLY here / in the host env. It is never written into the repo.
# QUOTE the value in this file. Without quotes the loader treats "#" as the start
# of a comment and silently truncates the link — and a Signal invite is ALL fragment.
# In Render's environment UI, paste the raw link with no quotes.
SIGNAL_LINK="https://signal.group/#REPLACE_WITH_YOUR_INVITE"

# --- SIGNING SECRETS --------------------------------------------------------
# Two DIFFERENT long random strings. Generate each with:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,'')+crypto.randomUUID().replace(/-/g,''))"
SESSION_SECRET=replace-with-a-long-random-string
OTP_SECRET=replace-with-a-DIFFERENT-long-random-string

# --- BREVO SMTP -------------------------------------------------------------
# Brevo dashboard -> SMTP & API -> SMTP tab.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
# The "from" address MUST be a verified sender in Brevo:
MAIL_FROM=Group Access <no-reply@yourdomain.com>

# --- RUNTIME ----------------------------------------------------------------
NODE_ENV=production
PORT=3000
